    "restart": "node server.js",
    "test": "echo \"MINI-ZYRA - No test, just run npm start\" && exit 0",
    "clean": "rm -rf sessions node_modules",
    "clean-sessions": "rm -rf sessions",
    "install-deps": "npm install",
    "update": "npm update",
    "check": "node -c server.js && node -c src/connection.js && node -c src/handler.js && echo OK",
